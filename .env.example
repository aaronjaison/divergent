# Copy to .env.local for development.

# MusicBrainz requires a contact address in the User-Agent header of every request.
# Requests with a missing or generic User-Agent get throttled or blocked.
APP_CONTACT_EMAIL=you@example.com
APP_USER_AGENT_NAME=Divergent
APP_VERSION=0.1.0

# SQLite file. Relative paths resolve from the project root.
DATABASE_FILE=./data/app.sqlite

# Public base URL, used for the Soundiiz handoff logo and share links.
APP_BASE_URL=http://localhost:3000

# --- Provider feature flags ---
# Deezer supplies the popularity/rank signal that powers "famous vs deep cuts".
# Its terms are non-commercial and registration is closed, so everything it
# returns is stored with licenseClass='noncommercial' and can be purged by
# scripts/purge-noncommercial.ts before any commercial launch.
PROVIDER_DEEZER_ENABLED=true

# Last.fm is optional dev-phase enrichment, off by default. Also non-commercial.
PROVIDER_LASTFM_ENABLED=false
LASTFM_API_KEY=

# Set true once a MetaBrainz supporter tier is active: flips MusicBrainz
# genre/tag data from licenseClass='noncommercial' to 'licensed' so the purge
# script leaves it alone.
METABRAINZ_COMMERCIAL_LICENSE=false
